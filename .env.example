# ODIN — Configuration (copier en .env et remplir)
# Ne jamais committer ce fichier avec de vraies valeurs !

# ── Oracle Database ──────────────────────────────────────────────────────────
# Format : host:port/service_name  (ex: monserveur:1521/ORCL)
ORACLE_DSN=localhost:1521/ORCL
ORACLE_USER=odin_user
ORACLE_PASSWORD=votre_mot_de_passe_ici

# ── Collecteur ───────────────────────────────────────────────────────────────
# Secondes entre chaque poll de V$SQL
POLL_INTERVAL=5

# Ignorer les requêtes plus rapides que X ms (0 = tout capturer)
MIN_ELAPSED_MS=0

# Ignorer les schémas système Oracle (SYS, SYSTEM, DBSNMP, etc.)
IGNORE_SYS=true

# ── Intelligence Artificielle ────────────────────────────────────────────────
# Provider disponibles : github-copilot | openai | anthropic | ollama
AI_PROVIDER=github-copilot

# Clé API du provider choisi
# - GitHub Copilot : token GitHub avec accès Copilot (ghp_xxx ou ghu_xxx)
# - OpenAI         : sk-xxx
# - Anthropic      : sk-ant-xxx
# - Ollama         : mettre "ollama" (valeur arbitraire, non vérifiée)
AI_API_KEY=

# Modèle à utiliser (selon le provider)
# GitHub Copilot : claude-sonnet-4.6 | claude-opus-4-5 | gpt-4o | gpt-4o-mini
# OpenAI         : gpt-4o | gpt-4o-mini | gpt-4-turbo
# Anthropic      : claude-3-5-sonnet-20241022 | claude-opus-4-5
# Ollama         : llama3 | mistral | qwen2.5-coder | gemma2
AI_MODEL=claude-sonnet-4.6

# URL de base de l'API IA
# GitHub Copilot : https://models.inference.ai.azure.com
# OpenAI direct  : laisser vide (utilise l'URL officielle par défaut)
# Ollama local   : http://localhost:11434/v1
AI_BASE_URL=https://models.inference.ai.azure.com

# Nombre maximum de tokens pour une analyse complète
# Plus élevé = analyse plus détaillée mais plus lente et coûteuse
AI_MAX_TOKENS=8000

# Budget de raisonnement (extended thinking) pour les modèles qui le supportent
# 0     = désactivé (~8s de réponse)
# 1024  = mode rapide (~10s)
# 5000  = mode standard (~30s, plus approfondi)
# 10000 = mode approfondi (~60s, pour les requêtes très complexes)
AI_THINKING_BUDGET=1024

# ── Interface Web ─────────────────────────────────────────────────────────────
# Adresse d'écoute (0.0.0.0 = toutes les interfaces, 127.0.0.1 = local seulement)
WEB_HOST=127.0.0.1

# Port de l'interface web
WEB_PORT=8080

# Accès web : aucune connexion admin possible tant que ce mot de passe est vide.
ODIN_ADMIN_PASSWORD=
# Facultatif : mot de passe distinct pour le rôle lecture seule.
ODIN_VIEWER_PASSWORD=
# Secret aléatoire long, stable entre les redémarrages (32 octets minimum).
# Vide : secret éphémère, les sessions expirent au redémarrage.
ODIN_SESSION_SECRET=
# Ne rendre les données lisibles sans connexion que sur un réseau de confiance.
ODIN_PUBLIC_READ=false
# Activer derrière HTTPS ; laisser false pour les essais HTTP locaux.
ODIN_COOKIE_SECURE=false
# Rejeu et SELECT libres de l'IA désactivés par défaut.
ODIN_ALLOW_QUERY_EXECUTION=false
ODIN_ORACLE_TIMEOUT_MS=30000
# Facultatif : fichier SQLite distinct, notamment pour les tests.
# ODIN_DB_PATH=/chemin/vers/odin.db

# ── Exemples de configurations alternatives ──────────────────────────────────

# --- OpenAI direct ---
# AI_PROVIDER=openai
# AI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# AI_MODEL=gpt-4o
# AI_BASE_URL=

# --- Anthropic direct ---
# AI_PROVIDER=anthropic
# AI_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# AI_MODEL=claude-3-5-sonnet-20241022
# AI_BASE_URL=

# --- Ollama local (100% gratuit, aucune donnée envoyée) ---
# AI_PROVIDER=ollama
# AI_API_KEY=ollama
# AI_MODEL=llama3
# AI_BASE_URL=http://localhost:11434/v1
